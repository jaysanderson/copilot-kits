# Secrets — NEVER commit. The KB token lives only in .env (server-side).
.env
.env.*
!.env.example

# Kendo/Telerik license key file — a credential; never commit it (either location).
telerik-license.txt
kendo-ui-license.txt

# .mcp.json ships (env-substitution `${NUCLIA_*}` only, no literal token — read
# at runtime, same as .cursor/.vscode configs). If a tool ever resolves a token
# into it locally, do NOT commit that change.

# Dependencies
node_modules/
portal/node_modules/

# Build output
portal/dist/
dist/

# Generated corpus (synthetic, regenerated per build)
corpus/generated/

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# Playwright MCP snapshots / screenshots (tool artifacts)
.playwright-mcp/

# Demo recordings (large video files)
recordings/
portal/.env

# NOTE (fixed in this app, 17 Aug 2026): demo.config.json used to be gitignored
# here as "generated by create-app.js, not shipped in the factory" - but the
# running app READS this file at runtime (server/index.mjs's loadConfig() and
# the client's /api/config) to drive its surfaces/theme/safety copy. Excluding
# it means a fresh `git clone` of this repo is missing the file the app needs
# to function - the same class of latent scaffold bug as the composition.tsx
# .gitignore exclusion CLAUDE.md already documents (Auto-co, 12 Aug 2026).
# Committed instead. Flag this upstream in the shared template's own
# .gitignore - do not silently re-exclude it in a future scaffold.
