# Copy to .env for local runs. In production these are Fly secrets
# (`flyctl secrets set ROI_PASSPHRASE=... ROI_SECRET_KEY=...`), never
# committed and never put in fly.toml.

# The one shared team passphrase gating every /api/* route. A case here
# holds a real account name and a buyer's real numbers, so this is not
# optional the way it would be on a synthetic demo KB.
ROI_PASSPHRASE=

# Signs the session cookie. Any long random string; rotate it and every
# browser is signed out (harmless - they just re-enter the passphrase).
ROI_SECRET_KEY=

# Optional - overrides where the SQLite file lives. Defaults to
# ./data/roi_cases.db next to app.py; the Fly volume mounts at /app/data.
# ROI_DB_PATH=./data/roi_cases.db
