# ARAG account-level credential (used only by seed/provision_kb.py to create a
# fresh Knowledge Box - not needed at app runtime once ARAG_KB_URL /
# ARAG_SERVICEACCOUNT below are set).
ARAG_ACCOUNT=
ARAG_NUA_KEY=
ARAG_ZONE=

# Per-KB service-account credential the running app actually uses. Minted by
# seed/provision_kb.py. ARAG_SERVICEACCOUNT is a server-side secret - never
# reference it from any client-side code.
ARAG_KB_ID=
ARAG_KB_URL=
ARAG_SERVICEACCOUNT=
