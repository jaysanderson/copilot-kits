# Copy to .env (gitignored) and fill in. Never commit .env. Never paste these values into chat or docs.
# Zonal API host, e.g. https://<zone>.rag.progress.cloud/api/v1  (the zone is infrastructure: keep it out of the UI)
ARAG_HOST=
# Knowledge Box id and its service-account token (reader is enough for ask/find; writer for upload)
KB_ID=
KB_TOKEN=
# Cheapest capable generative model, pinned on every call. Leave blank to use the client's default.
ARAG_MODEL=

# Asks per IP per minute on /api/* POST routes (0 disables)
RATE_LIMIT_PER_MIN=
